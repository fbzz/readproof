# Copy to .env and adjust as needed. .env is gitignored — never commit it.
# `docker compose` auto-loads a .env file in this directory; the Go
# binaries (readproof, readproofd) and test suite read these directly from the shell
# environment (`export`, or a tool like direnv / `set -a; source .env`).
#
# ⚠️  Every value below is a DEV-ONLY placeholder. Do not reuse these
# values, or the docker-compose.yml defaults they override, outside local
# development.

# --- docker-compose: Postgres ---
POSTGRES_USER=readproof
POSTGRES_PASSWORD=readproof_dev_password
POSTGRES_DB=readproof

# --- docker-compose: MinIO (also used as readproofd's S3 credentials) ---
MINIO_ROOT_USER=readproofadmin
MINIO_ROOT_PASSWORD=readproof_dev_password_minio

# --- readproofd ---
# READPROOFD_ADDR=:8080
# READPROOFD_DATA_DIR=.readproof        # embedded mode only (data-dir, unused when READPROOFD_POSTGRES_DSN is set)
# READPROOFD_POSTGRES_DSN=postgres://readproof:readproof_dev_password@localhost:5434/readproof?sslmode=disable
# READPROOFD_S3_ENDPOINT=localhost:9000
# READPROOFD_S3_ACCESS_KEY=readproofadmin
# READPROOFD_S3_SECRET_KEY=readproof_dev_password_minio
# READPROOFD_S3_BUCKET=readproof-blobs
# READPROOFD_S3_USE_SSL=false
# Off (unauthenticated) by default. Set a real, random value to require it
# on every request except /healthz — then the CLI/SDK need the same value.
# READPROOFD_API_KEY=
#
# Directories a filesystem-source resource may be read from. Separate with
# ',' or the OS path separator; repeatable as --filesystem-root. UNSET =
# filesystem sources are refused, which is the default: without a root,
# registering a resource would let any caller read any file readproofd can.
# READPROOFD_FILESYSTEM_ROOTS=/srv/policies,/srv/runbooks

# --- readproof CLI ---
# READPROOF_SERVER_URL=http://localhost:8080  # unset = embedded mode
# READPROOF_API_KEY=                         # must match readproofd's READPROOFD_API_KEY, if set
# READPROOF_HOME=.readproof                  # embedded mode data directory

# --- source adapters ---
# Read directly by readproofd at fetch time — never stored in a Resource's
# config. Required only for github-source resources against private repos
# or to avoid unauthenticated rate limits; http-source resources reference
# secrets via "${VAR_NAME}" header values resolved the same way.
# GITHUB_TOKEN=
#
# A "${VAR}" header on an http-source resource is resolved from readproofd's
# OWN environment and sent to whatever URL that resource names — so whoever
# can register a resource could otherwise read the server's environment.
# readproofd therefore expands NOTHING by default: name the variables a
# source header may reference, comma-separated (repeatable as
# --header-env-allow). readproofd's own credentials (READPROOFD_API_KEY,
# READPROOFD_POSTGRES_DSN, READPROOFD_S3_*) stay refused even if listed.
# READPROOFD_HEADER_ENV_ALLOWLIST=GITHUB_TOKEN,ACME_DOCS_TOKEN
#
# A second, process-level allow-list that applies to every Readproof process,
# the embedded CLI included (which is otherwise unrestricted, since that
# environment belongs to the person typing the command). Unset = no extra
# restriction; set = expansion is narrowed to these names as well.
# READPROOF_HTTP_HEADER_ENV_ALLOWLIST=GITHUB_TOKEN,ACME_DOCS_TOKEN

# --- OpenTelemetry ---
# Unset = tracing/metrics disabled (safe no-op), no collector required.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- live-infrastructure test suite (go test ./...) ---
# Unset = the Postgres/MinIO-backed tests skip themselves.
# READPROOF_TEST_POSTGRES_DSN=postgres://readproof:readproof_dev_password@localhost:5434/readproof?sslmode=disable
# READPROOF_TEST_MINIO_ENDPOINT=localhost:9000
# READPROOF_TEST_MINIO_ACCESS_KEY=readproofadmin
# READPROOF_TEST_MINIO_SECRET_KEY=readproof_dev_password_minio
