# Copy to .env and adjust as needed. .env is gitignored — never commit it.
# `docker compose` auto-loads a .env file in this directory; the Go
# binaries (ctx, ctxd) and test suite read these directly from the shell
# environment (`export`, or a tool like direnv / `set -a; source .env`).
#
# ⚠️  Every value below is a DEV-ONLY placeholder. Do not reuse these
# values, or the docker-compose.yml defaults they override, outside local
# development.

# --- docker-compose: Postgres ---
POSTGRES_USER=ctx
POSTGRES_PASSWORD=ctx_dev_password
POSTGRES_DB=ctx

# --- docker-compose: MinIO (also used as ctxd's S3 credentials) ---
MINIO_ROOT_USER=ctxadmin
MINIO_ROOT_PASSWORD=ctx_dev_password_minio

# --- ctxd ---
# CTXD_ADDR=:8080
# CTXD_DATA_DIR=.ctx                    # embedded mode only (data-dir, unused when CTXD_POSTGRES_DSN is set)
# CTXD_POSTGRES_DSN=postgres://ctx:ctx_dev_password@localhost:5434/ctx?sslmode=disable
# CTXD_S3_ENDPOINT=localhost:9000
# CTXD_S3_ACCESS_KEY=ctxadmin
# CTXD_S3_SECRET_KEY=ctx_dev_password_minio
# CTXD_S3_BUCKET=ctx-blobs
# CTXD_S3_USE_SSL=false
# Off (unauthenticated) by default. Set a real, random value to require it
# on every request except /healthz — then the CLI/SDK need the same value.
# CTXD_API_KEY=

# --- ctx CLI ---
# CTX_SERVER_URL=http://localhost:8080  # unset = embedded mode
# CTX_API_KEY=                          # must match ctxd's CTXD_API_KEY, if set
# CTX_HOME=.ctx                         # embedded mode data directory

# --- source adapters ---
# Read directly by ctxd at fetch time — never stored in a Resource's
# config. Required only for github-source resources against private repos
# or to avoid unauthenticated rate limits; http-source resources reference
# secrets via "${VAR_NAME}" header values resolved the same way.
# GITHUB_TOKEN=

# --- OpenTelemetry ---
# Unset = tracing/metrics disabled (safe no-op), no collector required.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- live-infrastructure test suite (go test ./...) ---
# Unset = the Postgres/MinIO-backed tests skip themselves.
# CTX_TEST_POSTGRES_DSN=postgres://ctx:ctx_dev_password@localhost:5434/ctx?sslmode=disable
# CTX_TEST_MINIO_ENDPOINT=localhost:9000
# CTX_TEST_MINIO_ACCESS_KEY=ctxadmin
# CTX_TEST_MINIO_SECRET_KEY=ctx_dev_password_minio
