{
  "name": "@readproof/sdk",
  "version": "0.3.2",
  "description": "TypeScript SDK for Readproof — reliable, versioned, reproducible context for AI agents.",
  "license": "Apache-2.0",
  "homepage": "https://fbzz.github.io/readproof/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fbzz/readproof.git",
    "directory": "sdk/typescript"
  },
  "bugs": {
    "url": "https://github.com/fbzz/readproof/issues"
  },
  "keywords": [
    "readproof",
    "ai-agents",
    "llm",
    "context",
    "provenance",
    "reproducibility",
    "replay",
    "manifest",
    "snapshot",
    "evidence",
    "in-toto",
    "audit",
    "mcp"
  ],
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "example": "npm run build && node dist/examples/resolve.js",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^26.2.0"
  }
}
