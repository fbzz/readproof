{
  "name": "dsh-plugin-readproof",
  "version": "0.3.1",
  "description": "DeepSeek Harness plugin for Readproof: stable readproof:// identity, freshness policy, snapshots, per-run manifests, diff, byte-exact replay, and evidence bundles as model-callable tools.",
  "license": "Apache-2.0",
  "homepage": "https://fbzz.github.io/readproof/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fbzz/readproof.git",
    "directory": "integrations/deepseek-harness/dsh-plugin-readproof"
  },
  "bugs": {
    "url": "https://github.com/fbzz/readproof/issues"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "readproof",
    "provenance",
    "evidence",
    "replay",
    "manifest",
    "ai-agents",
    "llm"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build && npm test",
    "prepack": "node scripts/prepack.mjs",
    "postpack": "node scripts/postpack.mjs"
  },
  "dependencies": {
    "@readproof/sdk": "file:../../../sdk/typescript",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.1",
    "@deepseek-ai/dsh-session": "0.1.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.1",
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  }
}
